/* hours.pld */

Name        hours ;
PartNo      00 ;
Date        09/26/26 ;
Revision    01 ;
Designer    koushiniku ;
Company     None ;
Assembly    None ;
Location    None ;
Device      g22v10 ;

/* inputs */
pin 11 = twelve;            /* 12-hour clock. False = 24-hour clock. */
pin [6..10,13] = [d0..d5];  /* BCD input. */

/* outputs */
pin 22 = !ampm;             /* Light AM/PM segments A,B,E,F,G. */
pin 21 = !am;               /* Light AM/PM segment C. */
pin [20..15] = [q0..q5];    /* BCD output. */
pin 14 = !blank;            /* Blank the high hour digit. */

field input = [twelve, d5..d0];
field output = [am, blank, q5..q0];

ampm = twelve;

table input => output {
    'b'0000000 => 'b'00000000; /* 00 */
    'b'0000001 => 'b'00000001; /* 01 */
    'b'0000010 => 'b'00000010; /* 02 */
    'b'0000011 => 'b'00000011; /* 03 */
    'b'0000100 => 'b'00000100; /* 04 */
    'b'0000101 => 'b'00000101; /* 05 */
    'b'0000110 => 'b'00000110; /* 06 */
    'b'0000111 => 'b'00000111; /* 07 */
    'b'0001000 => 'b'00001000; /* 08 */
    'b'0001001 => 'b'00001001; /* 09 */
    'b'0010000 => 'b'00010000; /* 10 */
    'b'0010001 => 'b'00010001; /* 11 */
    'b'0010010 => 'b'00010010; /* 12 */
    'b'0010011 => 'b'00010011; /* 13 */
    'b'0010100 => 'b'00010100; /* 14 */
    'b'0010101 => 'b'00010101; /* 15 */
    'b'0010110 => 'b'00010110; /* 16 */
    'b'0010111 => 'b'00010111; /* 17 */
    'b'0011000 => 'b'00011000; /* 18 */
    'b'0011001 => 'b'00011001; /* 19 */
    'b'0100000 => 'b'00100000; /* 20 */
    'b'0100001 => 'b'00100001; /* 21 */
    'b'0100010 => 'b'00100010; /* 22 */
    'b'0100011 => 'b'00100011; /* 23 */
    'b'1000000 => 'b'10010010; /* 12 AM */
    'b'1000001 => 'b'11XX0001; /*  1 AM */
    'b'1000010 => 'b'11XX0010; /*  2 AM */
    'b'1000011 => 'b'11XX0011; /*  3 AM */
    'b'1000100 => 'b'11XX0100; /*  4 AM */
    'b'1000101 => 'b'11XX0101; /*  5 AM */
    'b'1000110 => 'b'11XX0110; /*  6 AM */
    'b'1000111 => 'b'11XX0111; /*  7 AM */
    'b'1001000 => 'b'11XX1000; /*  8 AM */
    'b'1001001 => 'b'11XX1001; /*  9 AM */
    'b'1010000 => 'b'10010000; /* 10 AM */
    'b'1010001 => 'b'10010001; /* 11 AM */
    'b'1010010 => 'b'00010010; /* 12 PM */
    'b'1010011 => 'b'01XX0001; /*  1 PM */
    'b'1010100 => 'b'01XX0010; /*  2 PM */
    'b'1010101 => 'b'01XX0011; /*  3 PM */
    'b'1010110 => 'b'01XX0100; /*  4 PM */
    'b'1010111 => 'b'01XX0101; /*  5 PM */
    'b'1011000 => 'b'01XX0110; /*  6 PM */
    'b'1011001 => 'b'01XX0111; /*  7 PM */
    'b'1100000 => 'b'01XX1000; /*  8 PM */
    'b'1100001 => 'b'01XX1001; /*  9 PM */
    'b'1100010 => 'b'00010000; /* 10 PM */
    'b'1100011 => 'b'00010001; /* 11 PM */
}
