(version 1)

# 4 Layer JLCPCB, FR-4, 1oz outer, 0.5oz inner
# TBD: Blind slots, backdrill, BGA, trace coils

(rule "globals"
    (constraint hole_size (min 0.15mm) (max 6.3mm))
    (constraint solder_mask_expansion (opt 0mm))
    (constraint text_thickness (min 0.15mm))
    (constraint text_height (min 1.0mm))
    (constraint track_width (min 0.09mm))
    (constraint clearance (min 0.09mm))
    (constraint edge_clearance (min 0.2mm))
    (constraint via_diameter (min 0.45mm))
)

(rule "vias"
    (constraint hole_size (min 0.2mm))
    (constraint annular_width (min 0.075mm))
    (constraint hole_to_hole (min 0.2mm))
    (constraint hole_clearance (min 0.2mm))
    (condition "A.Type == 'Via'")
)

(rule "NTPHs"
    (constraint hole_size (min 0.50mm))
    (constraint hole_clearance (min 0.2mm))
    (condition "!A.isPlated()")
)

(rule "plated slots"
    (constraint hole_size (min 0.35mm))
    (condition "A.Hole_Size_X != A.Hole_Size_Y")
)

(rule "non-plated slots"
    (constraint hole_size (min 1.0mm))
    (condition "!A.isPlated() && A.Hole_Size_X != A.Hole_size_Y")
)

(rule "pads"
    (constraint hole_to_hole (min 0.45mm))
    (constraint annular_width (min 0.20mm))
    (constraint hole_clearance (min 0.35mm))
    (constraint silk_clearance (min 0.15mm))
    (condition "A.Type == 'Pad'")
)

(rule "castellated holes"
    (constraint hole_size (min 0.5mm))
    (constraint edge_clearance (min 1mm))
    (constraint hole_to_hole (min 0.5mm))
    (condition "A.Fabrication_Property == 'Castellated pad'")
)

(rule "inner PTH to copper clearance"
    (constraint hole_clearance (min 0.3mm))
    (layer inner)
    (condition "A.Type == 'Pad' && A.IsPlated()")
)

(rule "NPTH pads"
    (constraint annular_width (min 0.45mm))
    (condition "A.Type == 'Pad' && !A.isPlated()")
)

(rule "soldermask bridge"
    (constraint clearance (min 0.10mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad'")
)

(rule "zone clearance"
	(constraint clearance (min 10mil))
	(condition "A.Type == 'Zone'")
)
